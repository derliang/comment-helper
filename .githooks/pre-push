#!/bin/sh
# 本機 CI：push 前跑快速測試，沒過就擋下。
# 略過 tests/engine.test.mjs（約 5 分鐘）與 tests/*.py（E2E），兩者請手動跑，CI 也會跑。
# git 在 hook 內帶入 GIT_* 變數，會讓測試裡的 git 指令操作到真正的 repo，先清掉。
for v in $(env | grep '^GIT_' | cut -d= -f1); do unset "$v"; done
cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" || exit 1
for f in *.mjs server/*.mjs; do node --check "$f" || exit 1; done
files=$(ls tests/*.test.mjs | grep -v 'tests/engine.test.mjs')
node --test $files || { echo "[pre-push] 測試未通過，已擋下 push"; exit 1; }
